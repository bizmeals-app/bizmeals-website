# ─── BizMeals Environment Variables ───────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Prisma database connection string.
#   Local SQLite (dev):  file:./db/custom.db
#   Production examples:
#     Vercel Postgres:   postgres://user:pass@host/db
#     Turso (libSQL):    libsql://dbname.turso.io
#     Neon:              postgresql://user:pass@host/db
DATABASE_URL="file:./db/custom.db"
